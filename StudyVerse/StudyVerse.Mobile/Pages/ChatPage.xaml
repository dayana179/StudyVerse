<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="General Chat">

	<Grid
        RowDefinitions="Auto,*,Auto"
        Padding="16"
        RowSpacing="12">

		<!-- Header -->
		<Frame Grid.Row="0" Style="{StaticResource DarkPanel}" Padding="18">
			<VerticalStackLayout Spacing="12">

				<HorizontalStackLayout Spacing="12">
					<Frame Style="{StaticResource IconBox}">
						<Label
                            Text="💬"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
					</Frame>

					<VerticalStackLayout VerticalOptions="Center">
						<Label
                            Text="General Chat"
                            Style="{StaticResource PageTitle}"
                            FontSize="27" />

						<Label
                            x:Name="UserLabel"
                            Text=""
                            Style="{StaticResource PageSubtitle}" />
					</VerticalStackLayout>
				</HorizontalStackLayout>

				<Button
                    Text="Refresh Messages"
                    Style="{StaticResource OutlineButton}"
                    Clicked="RefreshClicked" />

			</VerticalStackLayout>
		</Frame>

		<!-- Chat messages -->
		<Frame Grid.Row="1" Style="{StaticResource ChatWindowPanel}">
			<CollectionView x:Name="MessagesCollection">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Frame
                            Style="{StaticResource BubbleCard}"
                            Margin="0,6">

							<VerticalStackLayout Spacing="8">

								<HorizontalStackLayout Spacing="10">

									<Frame Style="{StaticResource AvatarBox}">
										<Label
                                            Text="✦"
                                            TextColor="White"
                                            FontSize="18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
									</Frame>

									<VerticalStackLayout VerticalOptions="Center" Spacing="2">
										<Label
                                            Text="{Binding UserName}"
                                            FontSize="15"
                                            TextColor="{StaticResource TextDark}" />

										<Label
                                            Text="{Binding DisplayTime}"
                                            Style="{StaticResource MutedText}" />
									</VerticalStackLayout>

								</HorizontalStackLayout>

								<Label
                                    Text="{Binding Message}"
                                    Style="{StaticResource DarkText}"
                                    LineBreakMode="WordWrap" />

								<Frame
									IsVisible="{Binding HasForumPost}"
									Style="{StaticResource TagChip}">
									<Label
                                        Text="{Binding ForumPostTitle, StringFormat='Linked post: {0}'}"
                                        FontSize="12"
                                        TextColor="{StaticResource AccentPink}" />
								</Frame>

								<Button
                                    Text="Delete"
                                    Style="{StaticResource DangerButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="DeleteMessageClicked" />

							</VerticalStackLayout>
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Frame>

		<!-- Input box -->
		<Frame Grid.Row="2" Style="{StaticResource DarkPanel}" Padding="12">
			<VerticalStackLayout Spacing="8">

				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

					<Entry
						x:Name="MessageEntry"
						Grid.Column="0"
						Placeholder="Type a message..." />

					<Button
						x:Name="SendButton"
						Grid.Column="1"
						Text="Send"
						Style="{StaticResource BlueButton}"
						Clicked="SendClicked" />

				</Grid>

				<Label
					x:Name="CooldownLabel"
					Text=""
					FontSize="12"
					FontAttributes="Bold"
					FontFamily="Courier New"
					TextColor="#C8D6FF"
					HorizontalTextAlignment="Center" />

			</VerticalStackLayout>
		</Frame>

	</Grid>
</ContentPage>