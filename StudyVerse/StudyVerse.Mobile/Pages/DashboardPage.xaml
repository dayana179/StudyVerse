<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="StudyVerse"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="#9b7cff" />

            <Label
                Text="Your mobile study space"
                FontSize="16"
                TextColor="Gray" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Frame Grid.Row="0" Grid.Column="0" Padding="16" CornerRadius="18" BackgroundColor="#2b2b2b">
                    <VerticalStackLayout>
                        <Label Text="Forum" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Open discussions" TextColor="Gray" />
                        <Button Text="Open" Clicked="OpenForumClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" Padding="16" CornerRadius="18" BackgroundColor="#2b2b2b">
                    <VerticalStackLayout>
                        <Label Text="To-Do" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Manage tasks" TextColor="Gray" />
                        <Button Text="Open" Clicked="OpenTasksClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" Padding="16" CornerRadius="18" BackgroundColor="#2b2b2b">
                    <VerticalStackLayout>
                        <Label Text="Flashcards" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Review notes" TextColor="Gray" />
                        <Button Text="Open" Clicked="OpenFlashcardsClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="18" BackgroundColor="#2b2b2b">
                    <VerticalStackLayout>
                        <Label Text="Pomodoro" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Focus timer" TextColor="Gray" />
                        <Button Text="Open" Clicked="OpenPomodoroClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>