<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

	<ScrollView>
		<VerticalStackLayout Padding="18" Spacing="16">

			<!-- Profile header, same as MVC dashboard-profile -->
			<Frame Style="{StaticResource DarkPanel}">
				<VerticalStackLayout Spacing="16">

					<HorizontalStackLayout Spacing="14">

						<Frame
                            WidthRequest="74"
                            HeightRequest="74"
                            CornerRadius="37"
                            Padding="0"
                            Background="{StaticResource ButtonBlueGradient}"
                            BorderColor="{StaticResource AccentBlue}"
                            HasShadow="True">

							<Label
                                Text="✦"
                                TextColor="White"
                                FontSize="32"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
						</Frame>

						<VerticalStackLayout VerticalOptions="Center" Spacing="4">
							<Label
                                x:Name="WelcomeLabel"
                                Text="User"
                                FontSize="25"
                                TextColor="White" />

							<Label
                                Text="Welcome back to StudyVerse"
                                Style="{StaticResource PageSubtitle}" />

							<Button
                                Text="Edit Profile"
                                Style="{StaticResource OutlineButton}"
                                HeightRequest="38" />
						</VerticalStackLayout>

					</HorizontalStackLayout>

					<Button
                        Text="+ Add Task"
                        Style="{StaticResource LightButton}"
                        Clicked="OpenTasksClicked" />

				</VerticalStackLayout>
			</Frame>

			<!-- Stats row, same as MVC stats-row -->
			<Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

				<Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="4">
						<Label x:Name="TotalTasksLabel" Text="0" FontSize="32" TextColor="{StaticResource TextDark}" />
						<Label Text="Total Tasks" Style="{StaticResource MutedText}" />
					</VerticalStackLayout>
				</Frame>

				<Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="4">
						<Label x:Name="CompletedTasksLabel" Text="0" FontSize="32" TextColor="{StaticResource TextDark}" />
						<Label Text="Completed" Style="{StaticResource MutedText}" />
					</VerticalStackLayout>
				</Frame>

				<Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="4">
						<Label x:Name="PendingTasksLabel" Text="0" FontSize="32" TextColor="{StaticResource TextDark}" />
						<Label Text="Pending" Style="{StaticResource MutedText}" />
					</VerticalStackLayout>
				</Frame>

				<Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="4">
						<Label x:Name="ProgressLabel" Text="0%" FontSize="32" TextColor="{StaticResource AccentPink}" />
						<Label Text="Progress" Style="{StaticResource MutedText}" />
					</VerticalStackLayout>
				</Frame>

			</Grid>

			<!-- Progress bar -->
			<Frame
                Padding="0"
                HeightRequest="22"
                CornerRadius="11"
                BackgroundColor="#30FFFFFF"
                BorderColor="#588DA6FF"
                HasShadow="False">

				<Grid>
					<BoxView
                        x:Name="ProgressFill"
                        HorizontalOptions="Start"
                        BackgroundColor="{StaticResource AccentPink}"
                        CornerRadius="11"
                        WidthRequest="0" />

					<Label
                        x:Name="ProgressBarLabel"
                        Text="0%"
                        FontSize="12"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
				</Grid>
			</Frame>

			<!-- Dashboard grid like MVC -->
			<Grid
                ColumnDefinitions="*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="14">

				<!-- Today's Tasks -->
				<Frame Grid.Row="0" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="10">
						<Label Text="Today's Tasks" Style="{StaticResource DarkTitle}" />

						<BoxView HeightRequest="1" BackgroundColor="#588DA6FF" />

						<CollectionView x:Name="TodayTasksCollection" HeightRequest="160">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="*,Auto" Padding="0,7">
										<Label
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            Style="{StaticResource DarkText}" />

										<Label
                                            Grid.Column="1"
                                            Text="{Binding Priority}"
                                            TextColor="{StaticResource AccentPink}"
                                            FontSize="13" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
							<CollectionView.EmptyView>
								<Label Text="No tasks due today." Style="{StaticResource MutedText}" />
							</CollectionView.EmptyView>
						</CollectionView>

						<Button
                            Text="View all tasks"
                            Style="{StaticResource LightButton}"
                            Clicked="OpenTasksClicked" />
					</VerticalStackLayout>
				</Frame>

				<!-- Upcoming Tasks -->
				<Frame Grid.Row="1" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="10">
						<Label Text="Upcoming Tasks" Style="{StaticResource DarkTitle}" />

						<BoxView HeightRequest="1" BackgroundColor="#588DA6FF" />

						<CollectionView x:Name="UpcomingTasksCollection" HeightRequest="160">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="*,Auto" Padding="0,7">
										<Label
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            Style="{StaticResource DarkText}" />

										<Label
                                            Grid.Column="1"
                                            Text="{Binding DueDate, StringFormat='{0:dd MMM}'}"
                                            TextColor="{StaticResource AccentPink}"
                                            FontSize="13" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
							<CollectionView.EmptyView>
								<Label Text="No upcoming tasks." Style="{StaticResource MutedText}" />
							</CollectionView.EmptyView>
						</CollectionView>
					</VerticalStackLayout>
				</Frame>

				<!-- Recent Flashcards -->
				<Frame Grid.Row="2" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="10">
						<Label Text="Recent Flashcards" Style="{StaticResource DarkTitle}" />

						<BoxView HeightRequest="1" BackgroundColor="#588DA6FF" />

						<CollectionView x:Name="RecentDecksCollection" HeightRequest="160">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="*,Auto" Padding="0,7">
										<Label
                                            Grid.Column="0"
                                            Text="{Binding Name}"
                                            Style="{StaticResource DarkText}" />

										<Button
                                            Grid.Column="1"
                                            Text="Open"
                                            Style="{StaticResource LightButton}"
                                            HeightRequest="34"
                                            Clicked="OpenFlashcardsClicked" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
							<CollectionView.EmptyView>
								<Label Text="No flashcard decks yet." Style="{StaticResource MutedText}" />
							</CollectionView.EmptyView>
						</CollectionView>
					</VerticalStackLayout>
				</Frame>

				<!-- Recent Forum Posts -->
				<Frame Grid.Row="3" Style="{StaticResource PanelCard}">
					<VerticalStackLayout Spacing="10">
						<Label Text="Recent Forum Posts" Style="{StaticResource DarkTitle}" />

						<BoxView HeightRequest="1" BackgroundColor="#588DA6FF" />

						<CollectionView x:Name="RecentPostsCollection" HeightRequest="160">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="*,Auto" Padding="0,7">
										<Label
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            Style="{StaticResource DarkText}" />

										<Button
                                            Grid.Column="1"
                                            Text="Discuss"
                                            Style="{StaticResource LightButton}"
                                            HeightRequest="34"
                                            Clicked="OpenForumClicked" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
							<CollectionView.EmptyView>
								<Label Text="No forum posts yet." Style="{StaticResource MutedText}" />
							</CollectionView.EmptyView>
						</CollectionView>
					</VerticalStackLayout>
				</Frame>

			</Grid>

			<Button
                Text="Logout"
                Style="{StaticResource DangerButton}"
                Clicked="LogoutClicked" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>