<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.FlashcardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Flashcards">

	<ScrollView>
		<VerticalStackLayout Padding="22" Spacing="16">

			<Frame Style="{StaticResource StudyCard}">
				<VerticalStackLayout Spacing="6">
					<Label Text="Flashcards" Style="{StaticResource PageTitle}" />
					<Label x:Name="UserLabel" Text="" Style="{StaticResource PageSubtitle}" />
					<Label Text="Review questions and answers with a simple flip card."
                           Style="{StaticResource CardText}" />
				</VerticalStackLayout>
			</Frame>

			<Frame Style="{StaticResource StudyCard}">
				<VerticalStackLayout Spacing="10">
					<Label Text="Create Flashcard" Style="{StaticResource CardTitle}" />
					<Entry x:Name="QuestionEntry" Placeholder="Question" />
					<Entry x:Name="AnswerEntry" Placeholder="Answer" />
					<Button Text="Add Flashcard" Clicked="AddFlashcardClicked" />
					<Button Text="Refresh" Style="{StaticResource SecondaryButton}" Clicked="RefreshClicked" />
				</VerticalStackLayout>
			</Frame>

			<Frame
                Padding="26"
                CornerRadius="24"
                BackgroundColor="{StaticResource StudyVerseCard}"
                BorderColor="{StaticResource StudyVerseBorder}"
                HasShadow="True"
                MinimumHeightRequest="240">

				<VerticalStackLayout VerticalOptions="Center" Spacing="16">

					<Label
                        x:Name="CardLabel"
                        Text="No flashcards yet"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="{StaticResource StudyVerseText}"
                        HorizontalTextAlignment="Center" />

					<Label
                        x:Name="CountLabel"
                        Text=""
                        Style="{StaticResource CardText}"
                        HorizontalTextAlignment="Center" />

					<Button Text="Flip" Clicked="FlipCardClicked" />

				</VerticalStackLayout>
			</Frame>

			<HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
				<Button Text="Previous" Style="{StaticResource SecondaryButton}" Clicked="PreviousCardClicked" />
				<Button Text="Next" Style="{StaticResource SecondaryButton}" Clicked="NextCardClicked" />
				<Button Text="Delete" Style="{StaticResource DangerButton}" Clicked="DeleteCardClicked" />
			</HorizontalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>