<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.FlashcardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Flashcards">

	<Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="14">

		<Frame Grid.Row="0" Style="{StaticResource DarkPanel}">
			<VerticalStackLayout Spacing="12">

				<HorizontalStackLayout Spacing="14">
					<Frame Style="{StaticResource IconBox}">
						<Label
                            Text="▣"
                            FontSize="24"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
					</Frame>

					<VerticalStackLayout VerticalOptions="Center" Spacing="4">
						<Label Text="Flashcards" Style="{StaticResource PageTitle}" />
						<Label Text="Create decks and review your study cards." Style="{StaticResource PageSubtitle}" />
					</VerticalStackLayout>
				</HorizontalStackLayout>

				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
					<Button
                        Grid.Column="0"
                        Text="+ Create Deck"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="CreateDeckClicked" />

					<Button
                        Grid.Column="1"
                        Text="↻"
                        WidthRequest="52"
                        Style="{StaticResource OutlineButton}"
                        Clicked="RefreshClicked" />
				</Grid>

			</VerticalStackLayout>
		</Frame>

		<CollectionView x:Name="DeckCollection" Grid.Row="1">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Frame Style="{StaticResource PanelCard}" Margin="0,6">
						<VerticalStackLayout Spacing="10">

							<HorizontalStackLayout Spacing="10">
								<Frame Style="{StaticResource AvatarBox}">
									<Label
                                        Text="✦"
                                        TextColor="White"
                                        FontSize="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
								</Frame>

								<VerticalStackLayout VerticalOptions="Center" Spacing="2">
									<Label Text="{Binding Name}" Style="{StaticResource DarkTitle}" />
									<Label Text="{Binding CardCountText}" Style="{StaticResource MutedText}" />
								</VerticalStackLayout>
							</HorizontalStackLayout>

							<Label
                                Text="{Binding Description}"
                                Style="{StaticResource DarkText}"
                                LineBreakMode="WordWrap" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<Button
                                    Grid.Column="0"
                                    Text="Open"
                                    Style="{StaticResource PrimaryButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OpenDeckClicked" />

								<Button
                                    Grid.Column="1"
                                    Text="Delete"
                                    Style="{StaticResource DangerButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="DeleteDeckClicked" />
							</Grid>

						</VerticalStackLayout>
					</Frame>
				</DataTemplate>
			</CollectionView.ItemTemplate>

			<CollectionView.EmptyView>
				<Frame Style="{StaticResource PanelCard}" Margin="0,20">
					<Label
                        Text="No decks yet. Tap + Create Deck to start."
                        Style="{StaticResource DarkText}"
                        HorizontalTextAlignment="Center" />
				</Frame>
			</CollectionView.EmptyView>
		</CollectionView>

	</Grid>
</ContentPage>