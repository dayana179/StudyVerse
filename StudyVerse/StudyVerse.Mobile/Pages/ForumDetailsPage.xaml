<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.ForumDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Discussion">

    <Grid RowDefinitions="*,Auto" Padding="18" RowSpacing="12">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14">

                <Frame Style="{StaticResource DarkPanel}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="TitleLabel" Text="Post Title" Style="{StaticResource PageTitle}" />
                        <Label x:Name="MetaLabel" Text="" Style="{StaticResource PageSubtitle}" />

                        <Frame Style="{StaticResource TagChip}" HorizontalOptions="Start">
                            <Label
                                x:Name="CategoryLabel"
                                Text="General"
                                FontSize="12"
                                TextColor="{StaticResource AccentPink}" />
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource PanelCard}">
                    <Label
                        x:Name="ContentLabel"
                        Text=""
                        Style="{StaticResource DarkText}"
                        LineBreakMode="WordWrap" />
                </Frame>

                <Frame Style="{StaticResource PanelCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Attachments" Style="{StaticResource DarkTitle}" />

                        <CollectionView x:Name="AttachmentCollection">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Style="{StaticResource BubbleCard}" Margin="0,5">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="OnAttachmentTapped"
                                                CommandParameter="{Binding FullFileUrl}" />
                                        </Frame.GestureRecognizers>

                                        <VerticalStackLayout>
                                            <Label Text="{Binding FileName}" Style="{StaticResource DarkText}" />
                                            <Label Text="Tap to open" Style="{StaticResource MutedText}" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <Label Text="No attachments uploaded." Style="{StaticResource MutedText}" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource PanelCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Replies" Style="{StaticResource DarkTitle}" />

                        <CollectionView x:Name="RepliesCollection">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Style="{StaticResource BubbleCard}" Margin="0,5">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding UserName}" TextColor="{StaticResource AccentPink}" />
                                            <Label Text="{Binding Content}" Style="{StaticResource DarkText}" />
                                            <Label Text="{Binding DisplayDate}" Style="{StaticResource MutedText}" />

											<Frame
								              BackgroundColor="#20FFFFFF"
								              BorderColor="#B3FF82A0"
								              CornerRadius="12"
								              Padding="12,8"
								              HorizontalOptions="Start">

												            <Frame.GestureRecognizers>
													            <TapGestureRecognizer
														            Tapped="DeleteReplyTapped"
														            CommandParameter="{Binding Id}" />
												            </Frame.GestureRecognizers>

												            <Label
													            Text="Delete Reply"
													            FontFamily="Courier New"
													            FontAttributes="Bold"
													            TextColor="#FF9BB4"
													            FontSize="13" />
											            </Frame>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <Label Text="No replies yet. Be the first to reply." Style="{StaticResource MutedText}" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <Frame Grid.Row="1" Style="{StaticResource DarkPanel}" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    x:Name="ReplyEntry"
                    Grid.Column="0"
                    Placeholder="Write a reply..." />

                <Button
                    Grid.Column="1"
                    Text="Reply"
                    Style="{StaticResource BlueButton}"
                    Clicked="AddReplyClicked" />
            </Grid>
        </Frame>

    </Grid>
</ContentPage>