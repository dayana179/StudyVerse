<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.ForumPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Forum">

	<Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="14">

		<!-- Header -->
		<Frame Grid.Row="0" Style="{StaticResource DarkPanel}">
			<VerticalStackLayout Spacing="12">

				<HorizontalStackLayout Spacing="14">

					<Frame Style="{StaticResource IconBox}">
						<Label
                            Text="#"
                            FontSize="25"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
					</Frame>

					<VerticalStackLayout VerticalOptions="Center" Spacing="4">
						<Label
                            Text="Forum"
                            Style="{StaticResource PageTitle}" />

						<Label
                            Text="Browse discussion posts and study attachments."
                            Style="{StaticResource PageSubtitle}" />
					</VerticalStackLayout>

				</HorizontalStackLayout>

				<Button
                    Text="Refresh Posts"
                    Style="{StaticResource OutlineButton}"
                    Clicked="RefreshClicked" />

			</VerticalStackLayout>
		</Frame>

		<!-- Post list -->
		<CollectionView
            x:Name="ForumCollection"
            Grid.Row="1">

			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Frame
                        Style="{StaticResource PanelCard}"
                        Margin="0,6">

						<VerticalStackLayout Spacing="10">

							<HorizontalStackLayout Spacing="10">

								<Frame Style="{StaticResource AvatarBox}">
									<Label
                                        Text="✦"
                                        TextColor="White"
                                        FontSize="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
								</Frame>

								<VerticalStackLayout VerticalOptions="Center" Spacing="2">
									<Label
                                        Text="{Binding Title}"
                                        Style="{StaticResource DarkTitle}" />

									<Label
                                        Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy, hh:mm tt}'}"
                                        Style="{StaticResource MutedText}" />
								</VerticalStackLayout>

							</HorizontalStackLayout>

							<Frame Style="{StaticResource TagChip}" HorizontalOptions="Start">
								<Label
                                    Text="{Binding Category}"
                                    FontSize="12"
                                    TextColor="{StaticResource AccentPink}" />
							</Frame>

							<Label
                                Text="{Binding Content}"
                                Style="{StaticResource DarkText}"
                                LineBreakMode="TailTruncation"
                                MaxLines="3" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">

								<Button
                                    Grid.Column="0"
                                    Text="Details"
                                    Style="{StaticResource PrimaryButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnOpenDiscussionClicked" />
								<Button
                                    Grid.Column="1"
                                    Text="Attachments"
                                    Style="{StaticResource LightButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnOpenDiscussionClicked" />

							</Grid>

						</VerticalStackLayout>
					</Frame>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

	</Grid>
</ContentPage>