<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.ForumPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Forum">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Study Forum"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Discussion posts from StudyVerse"
                FontSize="14"
                TextColor="Gray" />

            <Button
                Text="Refresh"
                Clicked="OnRefreshClicked" />

            <CollectionView x:Name="ForumCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="15"
                            Margin="0,5"
                            CornerRadius="14"
                            BorderColor="#DDDDDD">

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding Title}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Category}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding Content}"
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="3" />

                                <Button
                                    Text="Open Discussion"
                                    Clicked="OnOpenDiscussionClicked"
                                    CommandParameter="{Binding Id}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>