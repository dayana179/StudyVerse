<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.PomodoroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pomodoro Timer">

	<Grid Background="#202B59">

		<ScrollView>
			<VerticalStackLayout
                Padding="22,34"
                Spacing="28"
                HorizontalOptions="Center">

				<!-- Title -->
				<VerticalStackLayout Spacing="8">
					<Label
                        Text="Pomodoro Timer"
                        FontSize="28"
                        FontFamily="Courier New"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

					<Label
                        Text="Stay focused with a 25-minute study session."
                        FontSize="13"
                        FontFamily="Courier New"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />
				</VerticalStackLayout>

				<!-- Timer circle -->
				<Grid
                    WidthRequest="280"
                    HeightRequest="280"
                    HorizontalOptions="Center">

					<!-- Outer purple ring -->
					<Ellipse
                        Fill="#B457B9"
                        WidthRequest="280"
                        HeightRequest="280"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

					<!-- Inner soft pink circle -->
					<Ellipse
                        Fill="#F0D8EF"
                        WidthRequest="250"
                        HeightRequest="250"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

					<!-- Timer text -->
					<VerticalStackLayout
                        Spacing="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

						<Label
                            x:Name="ModeLabel"
                            Text="Focus Session"
                            FontSize="13"
                            FontFamily="Courier New"
                            FontAttributes="Bold"
                            TextColor="#171D38"
                            HorizontalTextAlignment="Center" />

						<Label
                            x:Name="TimerLabel"
                            Text="25 : 00"
                            FontSize="38"
                            FontFamily="Courier New"
                            TextColor="#171D38"
                            HorizontalTextAlignment="Center" />

					</VerticalStackLayout>

				</Grid>

				<!-- Buttons -->
				<HorizontalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

					<Button
                        Text="Start"
                        BackgroundColor="White"
                        TextColor="#171D38"
                        BorderColor="White"
                        BorderWidth="1"
                        CornerRadius="10"
                        WidthRequest="78"
                        HeightRequest="42"
                        FontFamily="Courier New"
                        FontAttributes="Bold"
                        Clicked="StartClicked" />

					<Button
                        Text="Pause"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        BorderColor="White"
                        BorderWidth="1"
                        CornerRadius="10"
                        WidthRequest="78"
                        HeightRequest="42"
                        FontFamily="Courier New"
                        FontAttributes="Bold"
                        Clicked="PauseClicked" />

					<Button
                        Text="Reset"
                        BackgroundColor="Transparent"
                        TextColor="#FF8FAE"
                        BorderColor="#FF8FAE"
                        BorderWidth="1"
                        CornerRadius="10"
                        WidthRequest="78"
                        HeightRequest="42"
                        FontFamily="Courier New"
                        FontAttributes="Bold"
                        Clicked="ResetClicked" />

				</HorizontalStackLayout>

			</VerticalStackLayout>
		</ScrollView>

	</Grid>
</ContentPage>