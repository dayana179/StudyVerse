<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.PomodoroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pomodoro">

	<ScrollView>
		<VerticalStackLayout Padding="22" Spacing="18">

			<Frame Style="{StaticResource StudyCard}">
				<VerticalStackLayout Spacing="6">
					<Label Text="Pomodoro Timer" Style="{StaticResource PageTitle}" />
					<Label Text="Stay focused with study and break sessions."
                           Style="{StaticResource PageSubtitle}" />
				</VerticalStackLayout>
			</Frame>

			<Frame
                WidthRequest="270"
                HeightRequest="270"
                CornerRadius="135"
                BorderColor="{StaticResource StudyVersePurple}"
                BackgroundColor="{StaticResource StudyVerseCard}"
                HorizontalOptions="Center"
                HasShadow="True"
                Padding="20">

				<VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">

					<Label
                        x:Name="ModeLabel"
                        Text="Focus Session"
                        FontSize="18"
                        TextColor="{StaticResource StudyVersePink}"
                        HorizontalTextAlignment="Center" />

					<Label
                        x:Name="TimerLabel"
                        Text="25:00"
                        FontSize="52"
                        FontAttributes="Bold"
                        TextColor="{StaticResource StudyVerseText}"
                        HorizontalTextAlignment="Center" />

					<Label
                        x:Name="StatusLabel"
                        Text="Ready to focus"
                        FontSize="14"
                        TextColor="{StaticResource StudyVerseMuted}"
                        HorizontalTextAlignment="Center" />

				</VerticalStackLayout>
			</Frame>

			<HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
				<Button Text="Start" Clicked="StartClicked" />
				<Button Text="Pause" Style="{StaticResource SecondaryButton}" Clicked="PauseClicked" />
				<Button Text="Reset" Style="{StaticResource SecondaryButton}" Clicked="ResetClicked" />
			</HorizontalStackLayout>

			<Frame Style="{StaticResource StudyCard}">
				<VerticalStackLayout Spacing="10">
					<Label Text="Session Settings" Style="{StaticResource CardTitle}" />

					<HorizontalStackLayout Spacing="10">
						<Button Text="Focus 25 min" Style="{StaticResource SecondaryButton}" Clicked="SetFocusClicked" />
						<Button Text="Break 5 min" Style="{StaticResource SecondaryButton}" Clicked="SetBreakClicked" />
					</HorizontalStackLayout>

					<Label x:Name="SessionCountLabel"
                           Text="Completed focus sessions: 0"
                           Style="{StaticResource CardText}" />
				</VerticalStackLayout>
			</Frame>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>