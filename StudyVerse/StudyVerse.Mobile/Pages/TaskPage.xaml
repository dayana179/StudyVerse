<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.TaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="To-Do">

	<Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="14">

		<Frame Grid.Row="0" Style="{StaticResource DarkPanel}">
			<VerticalStackLayout Spacing="12">

				<HorizontalStackLayout Spacing="14">
					<Frame Style="{StaticResource IconBox}">
						<Label
                            Text="✓"
                            FontSize="25"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
					</Frame>

					<VerticalStackLayout VerticalOptions="Center" Spacing="4">
						<Label Text="To-Do" Style="{StaticResource PageTitle}" />
						<Label Text="Plan and manage your study tasks." Style="{StaticResource PageSubtitle}" />
					</VerticalStackLayout>
				</HorizontalStackLayout>

				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
					<Button
                        Grid.Column="0"
                        Text="+ Create Task"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="CreateTaskClicked" />

					<Button
                        Grid.Column="1"
                        Text="↻"
                        WidthRequest="52"
                        Style="{StaticResource OutlineButton}"
                        Clicked="RefreshClicked" />
				</Grid>

			</VerticalStackLayout>
		</Frame>

		<CollectionView x:Name="TaskCollection" Grid.Row="1">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Frame Style="{StaticResource PanelCard}" Margin="0,6">
						<VerticalStackLayout Spacing="10">

							<HorizontalStackLayout Spacing="10">
								<Frame Style="{StaticResource AvatarBox}">
									<Label
                                        Text="✎"
                                        TextColor="White"
                                        FontSize="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
								</Frame>

								<VerticalStackLayout VerticalOptions="Center" Spacing="2">
									<Label Text="{Binding Title}" Style="{StaticResource DarkTitle}" />

									<Label
                                        Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}"
                                        Style="{StaticResource MutedText}" />
								</VerticalStackLayout>
							</HorizontalStackLayout>

							<HorizontalStackLayout Spacing="8">
								<Frame Style="{StaticResource TagChip}" HorizontalOptions="Start">
									<Label
                                        Text="{Binding Priority}"
                                        FontSize="12"
                                        TextColor="{StaticResource AccentPink}" />
								</Frame>

								<Frame Style="{StaticResource TagChip}" HorizontalOptions="Start">
									<Label
                                        Text="{Binding StatusText}"
                                        FontSize="12"
                                        TextColor="{StaticResource AccentPink}" />
								</Frame>
							</HorizontalStackLayout>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<Button
                                    Grid.Column="0"
                                    Text="Edit"
                                    Style="{StaticResource LightButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="EditTaskClicked" />

								<Button
                                    Grid.Column="1"
                                    Text="Delete"
                                    Style="{StaticResource DangerButton}"
                                    CommandParameter="{Binding Id}"
                                    Clicked="DeleteTaskClicked" />
							</Grid>

						</VerticalStackLayout>
					</Frame>
				</DataTemplate>
			</CollectionView.ItemTemplate>

			<CollectionView.EmptyView>
				<Frame Style="{StaticResource PanelCard}" Margin="0,20">
					<Label
                        Text="No tasks yet. Tap + Create Task to add your first task."
                        Style="{StaticResource DarkText}"
                        HorizontalTextAlignment="Center" />
				</Frame>
			</CollectionView.EmptyView>
		</CollectionView>

	</Grid>
</ContentPage>