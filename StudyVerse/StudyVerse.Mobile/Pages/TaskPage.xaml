<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyVerse.Mobile.Pages.TaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="To-Do">

	<ScrollView>
		<VerticalStackLayout Padding="18" Spacing="16">

			<!-- Header -->
			<Frame Style="{StaticResource DarkPanel}">
				<HorizontalStackLayout Spacing="14">

					<Frame Style="{StaticResource IconBox}">
						<Label
                            Text="✓"
                            FontSize="25"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
					</Frame>

					<VerticalStackLayout VerticalOptions="Center" Spacing="4">
						<Label
                            Text="To-Do"
                            Style="{StaticResource PageTitle}" />

						<Label
                            Text="Plan your study tasks and track your progress."
                            Style="{StaticResource PageSubtitle}" />
					</VerticalStackLayout>

				</HorizontalStackLayout>
			</Frame>

			<!-- Add task card -->
			<Frame Style="{StaticResource PanelCard}">
				<VerticalStackLayout Spacing="12">

					<Label
                        Text="Add New Task"
                        Style="{StaticResource DarkTitle}" />

					<Entry
                        x:Name="TitleEntry"
                        Placeholder="Task title" />

					<Editor
                        x:Name="DescriptionEditor"
                        Placeholder="Task description"
                        HeightRequest="90" />

					<DatePicker x:Name="DueDatePicker" />

					<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
						<Button
                            Grid.Column="0"
                            Text="Add Task"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="AddTaskClicked" />

						<Button
                            Grid.Column="1"
                            Text="Refresh"
                            Style="{StaticResource LightButton}"
                            Clicked="RefreshClicked" />
					</Grid>

				</VerticalStackLayout>
			</Frame>

			<Label
                Text="Your Tasks"
                Style="{StaticResource PageTitle}"
                FontSize="24" />

			<!-- Task list -->
			<CollectionView x:Name="TaskCollection">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Frame
                            Style="{StaticResource PanelCard}"
                            Margin="0,6">

							<VerticalStackLayout Spacing="10">

								<HorizontalStackLayout Spacing="10">

									<Frame Style="{StaticResource AvatarBox}">
										<Label
                                            Text="✎"
                                            TextColor="White"
                                            FontSize="18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
									</Frame>

									<VerticalStackLayout VerticalOptions="Center" Spacing="2">
										<Label
                                            Text="{Binding Title}"
                                            Style="{StaticResource DarkTitle}" />

										<Label
                                            Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}"
                                            Style="{StaticResource MutedText}" />
									</VerticalStackLayout>

								</HorizontalStackLayout>

								<Label
                                    Text="{Binding Description}"
                                    Style="{StaticResource DarkText}"
                                    LineBreakMode="WordWrap" />

								<Frame Style="{StaticResource TagChip}" HorizontalOptions="Start">
									<Label
                                        Text="{Binding IsCompleted, StringFormat='Completed: {0}'}"
                                        FontSize="12"
                                        TextColor="{StaticResource AccentPink}" />
								</Frame>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
									<Button
                                        Grid.Column="0"
                                        Text="Toggle"
                                        Style="{StaticResource LightButton}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="ToggleTaskClicked" />

									<Button
                                        Grid.Column="1"
                                        Text="Delete"
                                        Style="{StaticResource DangerButton}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="DeleteTaskClicked" />
								</Grid>

							</VerticalStackLayout>

						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>