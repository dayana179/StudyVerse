@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <h1>StudyVerse</h1>
            <p>Enter your study space</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="auth-check">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe"></label>
            </div>

            <button type="submit" class="auth-btn">Login</button>

            <p class="auth-switch">
                New here?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}