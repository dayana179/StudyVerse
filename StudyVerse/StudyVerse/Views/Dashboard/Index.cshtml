@using StudyVerse.Models

@{
    ViewData["Title"] = "Dashboard";

    var todayTasks = ViewBag.TodayTasks as List<TaskItem>;
    var recentDecks = ViewBag.RecentDecks as List<FlashcardDeck>;
    var recentPosts = ViewBag.RecentPosts as List<ForumPost>;
}

<div class="dashboard-profile">
    <div class="profile-circle"></div>

    <div>
        <h1>@User.Identity?.Name</h1>
        <p class="text-muted mb-2">Welcome back to StudyVerse</p>

        <a class="btn btn-outline-dark btn-sm" asp-area="Identity" asp-page="/Account/Manage/Index">
            Edit Profile
        </a>
    </div>
</div>

<div class="stats-row mb-4">
    <div class="stat-box">
        <h3>@ViewBag.TotalTasks</h3>
        <p>Total Tasks</p>
    </div>

    <div class="stat-box">
        <h3>@ViewBag.CompletedTasks</h3>
        <p>Completed</p>
    </div>

    <div class="stat-box">
        <h3>@ViewBag.PendingTasks</h3>
        <p>Pending</p>
    </div>
</div>

<div class="dashboard-grid">
    <div class="dashboard-panel">
        <div class="d-flex justify-content-between align-items-center">
            <h5>Today's To-Do Tasks</h5>
            <a asp-controller="TaskItem" asp-action="Index">View all</a>
        </div>

        <hr />

        @if (todayTasks != null && todayTasks.Any())
        {
            foreach (var task in todayTasks)
            {
                <div class="mini-item">
                    <strong>@task.Title</strong>
                    <span>@task.Priority</span>
                </div>
            }
        }
        else
        {
            <p>No tasks due today.</p>
        }
    </div>

    <div class="dashboard-panel">
        <div class="d-flex justify-content-between align-items-center">
            <h5>Recent Flashcards</h5>
            <a asp-controller="Flashcards" asp-action="Index">View all</a>
        </div>

        <hr />

        @if (recentDecks != null && recentDecks.Any())
        {
            foreach (var deck in recentDecks)
            {
                <div class="mini-item">
                    <strong>@deck.Name</strong>
                    <span>@deck.CreatedAt.ToString("dd MMM")</span>
                </div>
            }
        }
        else
        {
            <p>No flashcard decks yet.</p>
        }
    </div>

    <div class="dashboard-panel">
        <div class="d-flex justify-content-between align-items-center">
            <h5>Recent Forum Posts</h5>
            <a asp-controller="ForumPost" asp-action="Index">View all</a>
        </div>

        <hr />

        @if (recentPosts != null && recentPosts.Any())
        {
            foreach (var post in recentPosts)
            {
                <div class="mini-item">
                    <strong>@post.Title</strong>
                    <span>@post.CreatedAt.ToString("dd MMM")</span>
                </div>
            }
        }
        else
        {
            <p>No forum posts yet.</p>
        }
    </div>

    <div class="dashboard-panel circle-panel">
        <h5>Pomodoro Timer</h5>
        <div class="small-timer-circle">
            25 : 00
        </div>
        <a class="btn btn-dark btn-sm mt-3" asp-controller="Pomodoro" asp-action="Index">
            Start Focus
        </a>
    </div>
</div>