@using StudyVerse.Models

@{
    ViewData["Title"] = "Dashboard";

    var todayTasks = ViewBag.TodayTasks as List<TaskItem>;
    var upcomingTasks = ViewBag.UpcomingTasks as List<TaskItem>;
    var recentDecks = ViewBag.RecentDecks as List<FlashcardDeck>;
    var recentPosts = ViewBag.RecentPosts as List<ForumPost>;

    int totalTasks = ViewBag.TotalTasks;
    int completedTasks = ViewBag.CompletedTasks;
    int pendingTasks = ViewBag.PendingTasks;

    int progress = totalTasks == 0 ? 0 : (completedTasks * 100 / totalTasks);
}

<div class="dashboard-profile">
    <div class="profile-circle"></div>

    <div>
        <h1>@User.Identity?.Name</h1>
        <p class="text-muted mb-2">Welcome back to StudyVerse</p>

        <a class="btn btn-outline-light btn-sm" asp-area="Identity" asp-page="/Account/Manage/Index">
            Edit Profile
        </a>
    </div>

    <a class="btn btn-light" asp-controller="TaskItem" asp-action="Create">+ Add Task</a>
</div>

@* <div class="dashboard-header">
    <div>
        <h1>Hello, @User.Identity?.Name</h1>
        <p>Here is your study progress today.</p>
    </div>

    <a class="btn btn-light" asp-controller="TaskItem" asp-action="Create">+ Add Task</a>
</div> *@

<div class="stats-row">
    <div class="stat-box">
        <h3>@totalTasks</h3>
        <p>Total Tasks</p>
    </div>

    <div class="stat-box">
        <h3>@completedTasks</h3>
        <p>Completed</p>
    </div>

    <div class="stat-box">
        <h3>@pendingTasks</h3>
        <p>Pending</p>
    </div>

    <div class="stat-box">
        <h3>@progress%</h3>
        <p>Progress</p>
    </div>
</div>

<div class="progress mt-3 mb-4" style="height: 22px;">
    <div class="progress-bar" style="width:@progress%; background-color:#af58af;">
        @progress%
    </div>
</div>


<div class="dashboard-grid">
    <div class="dashboard-panel">
        <h5>Today's Tasks</h5>
        <hr />

        @if (todayTasks != null && todayTasks.Any())
        {
            foreach (var task in todayTasks)
            {
                <div class="mini-item">
                    <span>@task.Title</span>
                    <strong>@task.Priority</strong>
                </div>
            }
        }
        else
        {
            <p>No tasks due today.</p>
        }

        <a asp-controller="TaskItem" asp-action="Index">View all tasks</a>
    </div>

    <div class="dashboard-panel">
        <h5>Upcoming Tasks</h5>
        <hr />

        @if (upcomingTasks != null && upcomingTasks.Any())
        {
            foreach (var task in upcomingTasks)
            {
                <div class="mini-item">
                    <span>@task.Title</span>
                    <strong>@task.DueDate.ToString("dd MMM")</strong>
                </div>
            }
        }
        else
        {
            <p>No upcoming tasks.</p>
        }
    </div>

    <div class="dashboard-panel">
        <h5>Recent Flashcards</h5>
        <hr />

        @if (recentDecks != null && recentDecks.Any())
        {
            foreach (var deck in recentDecks)
            {
                <div class="mini-item">
                    <span>@deck.Name</span>
                    <a asp-controller="Flashcards" asp-action="Details" asp-route-id="@deck.Id">Open</a>
                </div>
            }
        }
        else
        {
            <p>No flashcard decks yet.</p>
        }
    </div>

    <div class="dashboard-panel">
        <h5>Recent Forum Posts</h5>
        <hr />

        @if (recentPosts != null && recentPosts.Any())
        {
            foreach (var post in recentPosts)
            {
                <div class="mini-item">
                    <span>@post.Title</span>
                    <a asp-controller="ForumPost" asp-action="Details" asp-route-id="@post.Id">Discuss</a>
                </div>
            }
        }
        else
        {
            <p>No forum posts yet.</p>
        }
    </div>

    <div class="dashboard-panel circle-panel">
        <h5>Pomodoro Timer</h5>
        <div class="small-timer-circle">
            25 : 00
        </div>
        <a class="btn btn-dark btn-sm mt-3" asp-controller="Pomodoro" asp-action="Index">
            Start Focus
        </a>
    </div>
</div>