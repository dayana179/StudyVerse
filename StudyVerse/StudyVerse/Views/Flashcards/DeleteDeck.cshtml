@model StudyVerse.Models.FlashcardDeck

@{
    ViewData["Title"] = "Delete Deck";
}

<h2>Delete Flashcard Deck</h2>

<div class="form-card mx-0">
    <p>Are you sure you want to delete this deck?</p>

    <h4>@Model.Name</h4>
    <p>@Model.Description</p>
    <p>This will also remove all cards inside this deck.</p>

    <form asp-action="DeleteDeck" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>