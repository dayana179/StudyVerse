@model IEnumerable<StudyVerse.Models.FlashcardDeck>

@{
    ViewData["Title"] = "Flashcards";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Flashcard Decks</h2>
    <a class="btn btn-dark" asp-action="CreateDeck">+ Create Deck</a>
</div>

<div class="flashcard-grid">
    @foreach (var deck in Model)
    {
        <div class="flashcard-deck">
            <h4>@deck.Name</h4>
            <p>@deck.Description</p>
            <small>@(deck.Flashcards?.Count ?? 0) cards</small>

            <div class="mt-3">
                <a class="btn btn-sm btn-dark" asp-action="Details" asp-route-id="@deck.Id">Open</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="EditDeck" asp-route-id="@deck.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="DeleteDeck" asp-route-id="@deck.Id">Delete</a>
            </div>
        </div>
    }
</div>