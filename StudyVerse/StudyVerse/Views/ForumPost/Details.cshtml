@model StudyVerse.Models.ForumPost

@{
    ViewData["Title"] = "Forum Discussion";
}

<div class="discussion-page">
    <div class="discussion-post">
        <div class="discussion-header">
            <div>
                <span class="forum-tag">@(!string.IsNullOrWhiteSpace(Model.Category) ? Model.Category : "General")</span>
                <h2>@Model.Title</h2>
                <p class="text-muted">Started @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
            </div>

            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        </div>

        <p class="discussion-content">@Model.Content</p>

        @if (!string.IsNullOrEmpty(Model.AttachmentPath))
        {
            <div class="attachment-preview">
                <h5>Attachment</h5>
                <p>📎 @Model.AttachmentFileName</p>

                <a class="btn btn-sm btn-dark" href="@Model.AttachmentPath" target="_blank">
                    Open Attachment
                </a>

                <a class="btn btn-sm btn-outline-secondary" href="@Model.AttachmentPath" download>
                    Download
                </a>
            </div>
        }

        <div class="mt-4">
            <a class="btn btn-dark"
               asp-controller="Chat"
               asp-action="DiscussForumPost"
               asp-route-id="@Model.Id">
                Discuss in General Chat
            </a>
            <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
       
        </div>
    </div>

    <div class="reply-placeholder">
        <h5>Discussion Replies</h5>
        <p class="text-muted">Comment replies can be added later as an extra feature.</p>

        <textarea class="form-control" rows="3" placeholder="Reply feature coming soon..." disabled></textarea>
        <button class="btn btn-dark mt-2" disabled>Reply</button>
    </div>
</div>