@model StudyVerse.Models.ForumPost

@{
    ViewData["Title"] = "Forum Post Details";
}

<div class="forum-card">
    <h2>@Model.Title</h2>
    <p>@Model.Content</p>
    <small>Posted on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>