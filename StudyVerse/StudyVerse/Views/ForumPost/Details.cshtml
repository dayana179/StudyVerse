@model StudyVerse.Models.ForumPost
@using System.Security.Claims

@{
    ViewData["Title"] = "Forum Discussion";
}

<div class="discussion-page">
    <div class="discussion-post">
        <div class="discussion-header">
            <div>
                <span class="forum-tag">@(!string.IsNullOrWhiteSpace(Model.Category) ? Model.Category : "General")</span>
                <h2>@Model.Title</h2>
                <p class="text-muted">Started @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
            </div>

            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        </div>

        <p class="discussion-content">@Model.Content</p>

        @if (!string.IsNullOrEmpty(Model.AttachmentPath))
        {
            <div class="attachment-preview">
                <h5>Attachment</h5>
                <p>📎 @Model.AttachmentFileName</p>

                <a class="btn btn-sm btn-dark" href="@Model.AttachmentPath" target="_blank">
                    Open Attachment
                </a>

                <a class="btn btn-sm btn-outline-secondary" href="@Model.AttachmentPath" download>
                    Download
                </a>
            </div>
        }

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="mt-4">
                <h4>Attachments</h4>

                <div class="list-group">
                    @foreach (var attachment in Model.Attachments)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@attachment.FileName</strong>
                                <br />
                                <small class="text-muted">
                                    Size: @(attachment.FileSize / 1024) KB
                                </small>
                            </div>

                            <div>
                                <a href="@attachment.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                    Open
                                </a>

                                <a href="@attachment.FilePath" download class="btn btn-sm btn-outline-success">
                                    Download
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <p class="text-muted mt-3">No attachments uploaded.</p>
        }

        <div class="mt-4">
            <a class="btn btn-dark"
               asp-controller="Chat"
               asp-action="DiscussForumPost"
               asp-route-id="@Model.Id">
                Discuss in General Chat
            </a>

            <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        </div>
    </div>

    <div class="reply-placeholder">
        <div class="reply-header">
            <h5>Discussion Replies</h5>

            @if (Model.Replies != null && Model.Replies.Any())
            {
                <p class="text-muted">@Model.Replies.Count reply/replies</p>
            }
            else
            {
                <p class="text-muted">No replies yet. Be the first to reply.</p>
            }
        </div>

        @if (Model.Replies != null && Model.Replies.Any())
        {
            <div class="reply-list">
                @foreach (var reply in Model.Replies)
                {
                    <div class="reply-item">
                        <div class="reply-avatar">
                            @(string.IsNullOrWhiteSpace(reply.UserName) ? "U" : reply.UserName.Substring(0, 1).ToUpper())
                        </div>

                        <div class="reply-body">
                            <div class="reply-meta">
                                <strong>@(reply.UserName ?? "User")</strong>
                                <span class="text-muted">@reply.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>

                            <p>@reply.Content</p>

                            @if (reply.UserId == User.FindFirst(ClaimTypes.NameIdentifier)?.Value)
                            {
                                <form asp-action="DeleteReply" method="post" class="reply-delete-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reply.Id" />

                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <form asp-action="AddReply" method="post" class="reply-form mt-3">
            @Html.AntiForgeryToken()

            <input type="hidden" name="forumPostId" value="@Model.Id" />

            <textarea name="content"
                      class="form-control"
                      rows="3"
                      placeholder="Write your reply..."
                      required></textarea>

            <button type="submit" class="btn btn-dark mt-2">Reply</button>
        </form>
    </div>
</div>