@model IEnumerable<StudyVerse.Models.ForumPost>

@{
    ViewData["Title"] = "Forum";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Study Forum</h2>
    <a class="btn btn-dark" asp-action="Create">+ New Post</a>
</div>

@foreach (var post in Model)
{
    <div class="forum-card">
        <h4>@post.Title</h4>
        <p>@post.Content</p>
        <small>Posted on @post.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>

        <div class="mt-3">
            <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@post.Id">View</a>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@post.Id">Delete</a>
        </div>
    </div>
}