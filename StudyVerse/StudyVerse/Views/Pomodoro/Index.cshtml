@{
    ViewData["Title"] = "Pomodoro Timer";
}

<div class="pomodoro-page">
    <h2>Pomodoro Timer</h2>
    <p class="text-muted">Stay focused with a 25-minute study session.</p>

    <div class="pomodoro-circle">
        <div>
            <small>Focus Session</small>
            <h1 id="mainTimerDisplay">25 : 00</h1>
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-light" onclick="startPomodoro()">Start</button>
        <button class="btn btn-outline-light" onclick="pausePomodoro()">Pause</button>
        <button class="btn btn-outline-danger" onclick="resetPomodoro()">Reset</button>
    </div>

    <div class="music-box mt-4">
        <h5>Lofi Focus Music</h5>


        <button class="btn btn-sm btn-outline-dark" onclick="toggleMusic()">Play / Pause Music</button>
    </div>
</div>