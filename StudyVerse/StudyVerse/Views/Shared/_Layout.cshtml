@using Microsoft.AspNetCore.Identity
@using StudyVerse.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyVerse</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="studyverse-wrapper">

        <header class="topbar">
            <a class="brand" asp-controller="Home" asp-action="Index">StudyVerse</a>

            <div class="topbar-user">
                <partial name="_LoginPartial" />
            </div>
        </header>

        <div class="main-shell">
            @if (SignInManager.IsSignedIn(User))
            {
                <aside class="sidebar">
                    <a asp-controller="Dashboard" asp-action="Index">▶ Dashboard</a>
                    <a asp-controller="Chat" asp-action="Index">▷ General-chat</a>
                    <a asp-controller="TaskItem" asp-action="Index">▷ To-Do</a>
                    <a asp-controller="ForumPost" asp-action="Index">▷ Forum</a>
                    <a asp-controller="Flashcards" asp-action="Index">▷ Flashcards</a>
                    <a asp-controller="Pomodoro" asp-action="Index">▷ Pomodoro Timer</a>
                </aside>
            }

            <main class="content-area">
                @RenderBody()
            </main>
        </div>

        <footer class="footer-bar">
            Copyright
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>