@using Microsoft.AspNetCore.Identity
@using StudyVerse.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyVerse</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <audio id="globalLofiPlayer" loop>
        <source src="~/audio/lofi.mp3" type="audio/mpeg">
    </audio>

    <div class="studyverse-wrapper">

        <header class="topbar">
            <a class="brand" asp-controller="Home" asp-action="Index">StudyVerse</a>

            <div class="topbar-user">
                <partial name="_LoginPartial" />
            </div>
        </header>

        <div class="main-shell">
            @if (SignInManager.IsSignedIn(User))
            {
                <aside class="sidebar">
                    <a asp-controller="Dashboard" asp-action="Index">✦ Dashboard</a>
                    <a asp-controller="Chat" asp-action="Index">✦ General-chat</a>
                    <a asp-controller="TaskItem" asp-action="Index">✦ To-Do</a>
                    <a asp-controller="ForumPost" asp-action="Index">✦ Forum</a>
                    <a asp-controller="Flashcards" asp-action="Index">✦ Flashcards</a>
                    <a asp-controller="Pomodoro" asp-action="Index">✦ Pomodoro Timer</a>
                </aside>
            }

            <main class="content-area">
                @RenderBody()
            </main>
        </div>

        <footer class="footer-bar">
            <p style="color: #364384;">&copy; 2026 Group 14</p>
        </footer>
    </div>
    @if (SignInManager.IsSignedIn(User))
    {
        <div id="floatingPomodoro" class="floating-pomodoro">
            <div id="pomodoroDragHandle" class="floating-pomodoro-header">
                <strong class="pomodoro-title">Pomodoro</strong>

                <button type="button"
                        id="togglePomodoroMinimize"
                        class="pomodoro-minimize-btn"
                        title="Minimize timer">
                    −
                </button>
            </div>

            <div class="floating-timer-only">
                <span id="floatingTimerDisplay">25 : 00</span>
            </div>

            <div id="floatingPomodoroBody" class="floating-pomodoro-body">
                <div class="floating-buttons">
                    <button type="button" onclick="startPomodoro()">▶</button>
                    <button type="button" onclick="pausePomodoro()">Ⅱ</button>
                    <button type="button" onclick="resetPomodoro()">↺</button>
                </div>

                <hr />

                <div class="music-mini">
                    <strong>Focus Music</strong>

                    <button type="button" class="music-btn" onclick="toggleMusic()">
                        🎵 Play / Pause
                    </button>

                    <label class="volume-label">Volume</label>
                    <input type="range"
                           id="musicVolume"
                           min="0"
                           max="1"
                           step="0.1"
                           value="0.5"
                           onchange="changeMusicVolume(this.value)" />
                </div>
            </div>
        </div>
    }
>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>