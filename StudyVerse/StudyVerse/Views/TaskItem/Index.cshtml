@model IEnumerable<StudyVerse.Models.TaskItem>

@{
    ViewData["Title"] = "To-Do";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tasks</h2>
    <a class="btn btn-dark" asp-action="Create">+ Add Task</a>
</div>

<table class="table task-table">
    <thead>
        <tr>
            <th>Tasks</th>
            <th>Due date</th>
            <th>Priority</th>
            <th>Completion Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.DueDate.ToString("dd/M/yyyy")</td>
                <td>@task.Priority</td>
                <td>
                    @if (task.IsCompleted)
                    {
                        <span>☑</span>
                    }
                    else
                    {
                        <span>☐</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@task.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>