@model IEnumerable<StudyVerse.Models.TaskItem>

@{
    ViewData["Title"] = "To-Do";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tasks</h2>
    <a class="btn btn-light" asp-action="Create">+ Add Task</a>
</div>

<table class="table task-table">
    <thead>
        <tr>
            <th style="color: #d3b8ed;">Tasks</th>
            <th style="color: #d3b8ed;">Due date</th>
            <th style="color: #d3b8ed;">Priority</th>
            <th style="color: #d3b8ed;">Completion Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td style="color: #ffffff;">@task.Title</td>
                <td style="color: #ffffff;">@task.DueDate.ToString("dd/M/yyyy")</td>
                <td style="color: #ffffff;">@task.Priority</td>
                <td>
                    @if (task.IsCompleted)
                    {
                        <span style="color: #94ba68;">☑</span>
                    }
                    else
                    {
                        <span style="color: #ffffff;">☐</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-light" style="color: #d3b8ed;" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@task.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>